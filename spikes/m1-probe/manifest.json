{
  "manifest_version": 3,
  "name": "M1 Capability Probe",
  "version": "1.0.0",
  "minimum_chrome_version": "141",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "M1 Probe"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  }
}
