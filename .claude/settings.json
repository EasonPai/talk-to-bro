{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/roles/orca-team-hook.py\" --cli claude --event session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/roles/orca-team-hook.py\" --cli claude --event stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
