{
  "orca-team": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/roles/orca-team-hook.py\" --cli agy --event session-start",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/roles/orca-team-hook.py\" --cli agy --event pre-invocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/roles/orca-team-hook.py\" --cli agy --event stop",
        "timeout": 30
      }
    ]
  }
}
