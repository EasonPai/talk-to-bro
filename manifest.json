{
  "manifest_version": 3,
  "name": "Talk To Bro Personally",
  "version": "0.1.12",
  "description": "Chrome MV3 Extension for Talk To Bro Personally",
  "minimum_chrome_version": "141",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Talk To Bro Personally"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "叫 Pip 出來"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
